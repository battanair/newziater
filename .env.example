# ---------- Firebase (público: van al navegador, no son secretos) ----------
# Consola de Firebase → Configuración del proyecto → Tus apps → Ziater (web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ziater2.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ziater2
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=442908543941
NEXT_PUBLIC_FIREBASE_APP_ID=1:442908543941:web:4b6320865b60d3ee1619ac

# ---------- Cloudinary ----------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dk0vvcpyn
# Solo la usa el servidor (firma las subidas), por eso no lleva NEXT_PUBLIC_
CLOUDINARY_API_KEY=
# SECRETO: solo en el servidor (Vercel → Settings → Environment Variables). Nunca con NEXT_PUBLIC_
CLOUDINARY_API_SECRET=

# ---------- Sitio ----------
NEXT_PUBLIC_SITE_URL=https://ziater.com
